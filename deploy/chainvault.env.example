# sourced by the cron entries and read by the archiver, proofs poller and PM2 config
CV_WORKDIR=/home/tippyflits/chainvault
CV_NETWORK=calibration
CV_CHAIN=calibnet
CV_COPIES=2
CV_PROVIDERS=9,4
CV_PARALLEL=4
CV_KEEP_LOCAL=1
CV_KEEP_ONCHAIN=6
CV_MIN_INTERVAL_EPOCHS=0
PATH=/home/tippyflits/.nvm/versions/node/v22.21.0/bin:/usr/local/bin:/usr/bin:/bin
PRIVATE_KEY=0x...calibnet-only wallet, never commit
CV_REHYDRATE_TOKEN=change-me
CV_REHYDRATE_PROVIDER=4
# optional: run a Forest import after each rehydration (see deploy/forest.sh for the Docker wrapper)
CV_FOREST_BIN=
CV_FOREST_ARGS="--chain calibnet --encrypt-keystore false --halt-after-import"
